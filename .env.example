# ===== ROUTERAI.RU (рекомендуется для РФ) =====
# Ключ: https://routerai.ru/settings/keys
ROUTERAI_API_KEY=sk-your-key-here

# Провайдер LLM
LLM_PROVIDER=openai

# Модель в формате "провайдер/модель"
LLM_MODEL=openai/gpt-6.1-terra-pro

# Endpoint RouterAI
OPENAI_BASE_URL=https://routerai.ru/api/v1

# Настройки генерации
MAX_TOKENS=4096
TEMPERATURE=0.3
OPENAI_TIMEOUT=60

# ===== АЛЬТЕРНАТИВА: Прямой OpenAI =====
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== АЛЬТЕРНАТИВА: Anthropic =====
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here